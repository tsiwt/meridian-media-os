# Copy to .env for docker compose or export before `python -m app.server`.
# Values below are safe defaults. Never commit real credentials.

HOST=0.0.0.0
PORT=7860
DB_PATH=./data/meridian.db
SEED_ON_BOOT=1
SEED=1024
LOG_LEVEL=INFO

# Simulation clock
SIM_START=2026-10-24T13:55:00Z
SIM_SPEED=1.0
SIM_AUTOPLAY=1
DECISION_INTERVAL=15
PRESENCE_WINDOW=30

# Evidence freshness (seconds)
FEED_FRESH_SECONDS=180
AODB_FRESH_SECONDS=900
MAX_HISTORY_DAYS=30

# Adapter switches: mock-aodb | vendor-api, mock-aidx | live-aidx, mock-acris | live-acris
FLIGHT_SOURCE=mock-aodb
AIDX_SOURCE=mock-aidx
ACRIS_SOURCE=mock-acris

# Pluggable AI provider; mock works offline with no key
AI_PROVIDER=mock
AI_MODEL=mock-evidence-v1

# Public origin for QR claim links (leave empty to auto-detect LAN/host)
PUBLIC_BASE_URL=

# White-label and i18n
PRODUCT_NAME=Meridian Media OS
PRODUCT_SHORT=MMOS
AIRPORT_CODE=MQI
AIRPORT_NAME=Meridian International Airport
CURRENCY=EUR
LOCALE=en
SECOND_LANGUAGE=zh
